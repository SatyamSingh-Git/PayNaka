# Blade is cross-platform: one package serves React Web and React Native. Installing it
# for web still drags in the React Native peer graph, and @floating-ui/react-native pulls
# react-native@0.87, which demands React 19 while Blade itself is happy with React >=18.
#
# None of that code is reachable from a web build -- Vite never resolves the .native.tsx
# entrypoints -- so the conflict is a packaging artefact rather than a real one. This is
# the documented way web consumers install Blade.
legacy-peer-deps=true
