# ---- Razorpay (TEST MODE ONLY) -------------------------------------------
# Dashboard -> toggle to Test Mode -> Settings -> API Keys.
# PayNaka refuses to start if the key does not begin with rzp_test_.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# ---- the model under test ------------------------------------------------
# HAAT measures whether a REAL model can be talked into moving money, so it needs a
# real one. Either provider works; OpenRouter is cheaper and reaches more families,
# and running several families is a stronger result than running one.

# OpenRouter (recommended). Slugs are provider/model.
OPENROUTER_API_KEY=
PAYNAKA_BENCH_MODEL=deepseek/deepseek-v4-flash

# Anthropic first-party (optional).
ANTHROPIC_API_KEY=
PAYNAKA_AGENT_MODEL=claude-opus-5

# The judge defence row. Any spec build_brain() understands.
PAYNAKA_JUDGE_MODEL=openai/gpt-5.6-luna

# ---- runtime -------------------------------------------------------------
# sandbox | production.  /_test/poison only exists in sandbox.
PAYNAKA_ENV=sandbox
PAYNAKA_DB=var/paynaka.db
# Set these to real paths and the service remembers across a restart: idempotency,
# mandate spend, escalations, revocations and the audit chain. Leave them unset (or
# `:memory:`) and it is the demo runtime, which forgets everything -- `/api/health`
# reports which of the two you are running under `durable`.
PAYNAKA_STATE_DB=var/state.db
PAYNAKA_AUDIT_DB=var/audit.db
MERCHANT_BASE_URL=http://127.0.0.1:8001
PAYNAKA_BASE_URL=http://127.0.0.1:8002

# ---- mandate signing -----------------------------------------------------
# Generated by `make setup`; a dev-only key lives in var/. Never commit one.
# Without this a fresh key is generated every boot, which invalidates every mandate
# ever issued -- the signature check becomes meaningless across a restart.
PAYNAKA_SIGNING_KEY_PATH=var/mandate_ed25519.key

# ---- who may ask ---------------------------------------------------------
# Taking payment credentials away from the agent buys nothing if the surface it asks
# through is open to every caller. So /mcp authenticates, always -- there is no
# unauthenticated path and no switch that turns the check off.
#
# Format: name:token pairs, comma-separated. The name lands in the audit trail, so it
# should say which agent this is. A token may contain a colon but not a comma, and
# anything shorter than 24 characters is refused at startup.
#
#   PAYNAKA_AGENT_TOKENS=buyer-agent:$(openssl rand -base64 32)
#
# Left unset with PAYNAKA_RAIL=sim, the service mints a development credential into
# var/dev-agent-token and prints it. Left unset with PAYNAKA_RAIL=test, the service
# refuses to start: reaching a real payment API behind a token invented at boot is not
# a thing to do by default.
# PAYNAKA_AGENT_TOKENS=

# ---- receiving webhooks --------------------------------------------------
# The endpoint secret from the Razorpay dashboard for this webhook. PayNaka verifies
# HMAC-SHA256 over the raw request body before believing a single field of it.
#
# Unset, every delivery is refused. There is deliberately no development mode that skips
# verification: an unverified webhook is an instruction to write the ledger, from anybody
# at all. Under 16 characters is refused at startup.
# RAZORPAY_WEBHOOK_SECRET=

# ---- who may approve a step-up -------------------------------------------
# Same format as PAYNAKA_AGENT_TOKENS, and deliberately a *different* set. A step-up the
# buying agent can answer on its own behalf is not an escalation, it is theatre -- so a
# name or a token appearing in both is a startup failure rather than a subtle overlap.
#
# Left unset, nobody can approve anything and every step-up runs out its window to DENY.
# That is the fail-closed direction and it is what "unanswered" is supposed to mean.
#
#   PAYNAKA_APPROVER_TOKENS=ops-anita:$(openssl rand -base64 32)
# PAYNAKA_APPROVER_TOKENS=

# ---- enforce, or observe -------------------------------------------------
# enforce = act on the decision. The default, because a checkpoint that does not
#           enforce unless told to is one somebody forgot to switch on.
# observe = decide, record, and let the request through anyway.
#
# observe is how this gets adopted rather than admired: run it beside live traffic for a
# week changing nothing, then read GET /api/shadow -- these are the calls that would have
# been blocked, this is how much money was involved, this is the check that caught each.
#
# The mode is stamped on every audit record, so it is never possible to read the chain
# later and believe the checkpoint was enforcing when it was not. A typo here is a startup
# failure, not a silent fallback -- one of these values enforces nothing.
PAYNAKA_MODE=enforce

# ---- rail selection ------------------------------------------------------
# sim  = deterministic in-process simulator (benchmark, CI, offline dev)
# test = real Razorpay test-mode API (demo + video)
PAYNAKA_RAIL=sim
