# ---- Razorpay (TEST MODE ONLY) -------------------------------------------
# Dashboard -> toggle to Test Mode -> Settings -> API Keys.
# PayNaka refuses to start if the key does not begin with rzp_test_.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# ---- the model under test ------------------------------------------------
# HAAT measures whether a REAL model can be talked into moving money, so it needs a
# real one. Either provider works; OpenRouter is cheaper and reaches more families,
# and running several families is a stronger result than running one.

# OpenRouter (recommended). Slugs are provider/model.
OPENROUTER_API_KEY=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
PAYNAKA_BENCH_MODEL=deepseek/deepseek-v4-flash

# Anthropic first-party (optional).
ANTHROPIC_API_KEY=
PAYNAKA_AGENT_MODEL=claude-opus-5

# The judge defence row. Any spec build_brain() understands.
PAYNAKA_JUDGE_MODEL=openai/gpt-5.6-luna

# ---- runtime -------------------------------------------------------------
# sandbox | production.  /_test/poison only exists in sandbox.
PAYNAKA_ENV=sandbox
PAYNAKA_DB=var/paynaka.db
PAYNAKA_AUDIT_DB=var/audit.db
MERCHANT_BASE_URL=http://127.0.0.1:8001
PAYNAKA_BASE_URL=http://127.0.0.1:8002

# ---- mandate signing -----------------------------------------------------
# Generated by `make setup`; a dev-only key lives in var/. Never commit one.
PAYNAKA_SIGNING_KEY_PATH=var/mandate_ed25519.key

# ---- rail selection ------------------------------------------------------
# sim  = deterministic in-process simulator (benchmark, CI, offline dev)
# test = real Razorpay test-mode API (demo + video)
PAYNAKA_RAIL=sim
